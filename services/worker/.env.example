# Pass explicitly: python -m saham_signal.worker --env-file .env.worker
APP_MODE=research
DATABASE_URL=postgresql://saham_signal_research:local_only_research@127.0.0.1:5432/saham_signal_research
REDIS_URL=redis://:local_redis_research@127.0.0.1:6379/0
REDIS_NAMESPACE=saham-signal:research:
WORKER_HEARTBEAT_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=1
WORKER_SHUTDOWN_SECONDS=10
# Paper/live also require SESSION_SECRET and PILOT_ACCOUNT_ID; see API README.
