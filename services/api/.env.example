# Explicitly load this file with: python -m saham_signal.transport.http --env-file .env
APP_MODE=research
DATABASE_URL=postgresql://saham_signal_research:local_only_research@127.0.0.1:5432/saham_signal_research
REDIS_URL=redis://:local_redis_research@127.0.0.1:6379/0
REDIS_NAMESPACE=saham-signal:research:
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
READINESS_TIMEOUT_SECONDS=3
# Required for paper/live. No authentication routes exist in this bootstrap.
SESSION_SECRET=
PILOT_ACCOUNT_ID=
# Local research scenario only; keep disabled in paper/live. Never commit a real token.
MARKET_FIXTURE_ENABLED=false
MARKET_FIXTURE_TOKEN=
MARKET_NOMINAL_IDR=1000000.00
MARKET_HORIZON_MINUTES=30
