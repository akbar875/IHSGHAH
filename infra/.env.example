# Research defaults. Copy to infra/.env.research.
# For .env.paper / .env.live, change ports/passwords using the README table.
# Only these four keys are accepted; plain values, no quotes/interpolation.
# Passwords: 12+ URL-safe characters [A-Za-z0-9_-]. Local development only.
LOCAL_POSTGRES_PORT=5432
LOCAL_REDIS_PORT=6379
LOCAL_POSTGRES_PASSWORD=local_only_research
LOCAL_REDIS_PASSWORD=local_redis_research
