# Shared local defaults; see services/api/.env.example for complete API settings.
APP_MODE=research
DISPLAY_TIMEZONE=Asia/Jakarta
# UTC for persisted timestamps. Never expose server secrets via NEXT_PUBLIC_*.
DATABASE_URL=postgresql://saham_signal_research:local_only_research@127.0.0.1:5432/saham_signal_research
REDIS_URL=redis://:local_redis_research@127.0.0.1:6379/0
REDIS_NAMESPACE=saham-signal:research:
# Set vendor credentials locally after provider selection; never commit them.
MARKET_DATA_API_KEY=
