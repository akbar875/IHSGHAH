{
  "name": "@saham-signal/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run contracts:check && npm run lint && npm run typecheck && npm run build",
    "contracts": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "test": "playwright test"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
